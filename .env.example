# Server port
PORT=3001

# Login password
APP_PASSWORD=changeme

# JWT signing secret (auto-generated if not set, but tokens won't survive restarts)
JWT_SECRET=

# Absolute path to the folder containing your album subfolders
ALBUMS_DIR=C:\path\to\your\Albums

# Ngrok auth token for remote tunneling (optional)
NGROK_AUTHTOKEN=

# Comma-separated list of allowed CORS origins (* = all)
CORS_ORIGINS=*
