# Server port
PORT=3001

# Login password
APP_PASSWORD=changeme

# JWT signing secret (auto-generated if not set, but tokens won't survive restarts)
JWT_SECRET=

# Absolute path to the folder containing your album subfolders
ALBUMS_DIR=C:\path\to\your\Albums

# ─── Tunnel Configuration ───────────────────────────────────
# Choose how to expose your backend to the internet:
#   0 = No tunnel (local only, default)
#   1 = ngrok    (requires NGROK_AUTHTOKEN)
#   2 = Cloudflare Tunnel (no auth needed for quick tunnels)
TUNNEL_MODE=0

# Required only if TUNNEL_MODE=1
NGROK_AUTHTOKEN=

# Comma-separated list of allowed CORS origins (* = all)
CORS_ORIGINS=*
